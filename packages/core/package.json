{
  "name": "@agentcsp/core",
  "version": "0.2.0",
  "description": "Local-first AI agent security scanner, manifest, policy, rule, graph, and reporting engine.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indranilroy99/agentcsp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/indranilroy99/agentcsp/issues"
  },
  "homepage": "https://github.com/indranilroy99/agentcsp#readme",
  "keywords": [
    "ai-security",
    "agent-security",
    "context-security-policy",
    "mcp",
    "sarif",
    "security-scanner"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./json-schemas/*": {
      "default": "./dist/json-schemas/*"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force && node ../../scripts/copy-built-in-rules.mjs && node ../../scripts/copy-json-schemas.mjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "minimatch": "^10.0.1",
    "smol-toml": "^1.7.0",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
