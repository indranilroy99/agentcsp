{
  "$ref": "#/definitions/AgentCSP Finding",
  "definitions": {
    "AgentCSP Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "very_high"
          ]
        },
        "confidence_rationale": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "matched_object": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "agent",
                "instruction",
                "skill",
                "plugin",
                "mcp_server",
                "tool",
                "prompt",
                "rag_source",
                "memory",
                "secret",
                "runtime_config",
                "ci_cd",
                "automation"
              ]
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "trust_level": {
              "type": "string",
              "enum": [
                "trusted",
                "project",
                "workspace",
                "third_party",
                "untrusted",
                "unknown"
              ],
              "default": "unknown"
            },
            "data_classes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "secret",
                  "credential",
                  "pii",
                  "unknown"
                ]
              },
              "default": []
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "read",
                  "write",
                  "execute",
                  "publish",
                  "send",
                  "delete",
                  "approve",
                  "remember",
                  "call"
                ]
              },
              "default": []
            },
            "side_effect": {
              "type": "boolean",
              "default": false
            },
            "reversible": {
              "type": "boolean",
              "default": true
            },
            "external_reach": {
              "type": "boolean",
              "default": false
            },
            "secret_exposure": {
              "type": "boolean",
              "default": false
            },
            "untrusted_to_privileged": {
              "type": "boolean",
              "default": false
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "object_id": {
                    "type": "string"
                  },
                  "file_path": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "snippet": {
                    "type": "string",
                    "const": "[redacted by default]",
                    "default": "[redacted by default]"
                  },
                  "redacted": {
                    "type": "boolean",
                    "const": true,
                    "default": true
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "object_id",
                  "file_path",
                  "reason"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "metadata": {
              "type": "object",
              "additionalProperties": {},
              "default": {}
            }
          },
          "required": [
            "id",
            "type",
            "name",
            "path"
          ],
          "additionalProperties": false
        },
        "file_path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "trust_boundary_crossed": {
          "type": "boolean"
        },
        "data_classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AgentCSP Finding/properties/matched_object/properties/data_classes/items"
          }
        },
        "recommended_control": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "require_approval",
            "redact",
            "quarantine",
            "warn"
          ]
        },
        "risk": {
          "type": "object",
          "properties": {
            "trust_level": {
              "$ref": "#/definitions/AgentCSP Finding/properties/matched_object/properties/trust_level"
            },
            "data_classes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AgentCSP Finding/properties/matched_object/properties/data_classes/items"
              },
              "default": []
            },
            "actions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AgentCSP Finding/properties/matched_object/properties/actions/items"
              },
              "default": []
            },
            "side_effect": {
              "type": "boolean",
              "default": false
            },
            "reversible": {
              "type": "boolean",
              "default": true
            },
            "external_reach": {
              "type": "boolean",
              "default": false
            },
            "secret_exposure": {
              "type": "boolean",
              "default": false
            },
            "untrusted_to_privileged": {
              "type": "boolean",
              "default": false
            },
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 0
            },
            "rationale": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "required": [
            "trust_level"
          ],
          "additionalProperties": false
        },
        "maps_to": {
          "type": "object",
          "properties": {
            "owasp": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "mitre_atlas": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "nist_ai_rmf": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {
            "owasp": [],
            "mitre_atlas": [],
            "nist_ai_rmf": []
          }
        },
        "policy_control": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "control": {
              "$ref": "#/definitions/AgentCSP Finding/properties/recommended_control"
            },
            "previous_control": {
              "$ref": "#/definitions/AgentCSP Finding/properties/recommended_control"
            },
            "reason": {
              "type": "string"
            },
            "matched_on": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "applied_at": {
              "type": "string"
            }
          },
          "required": [
            "control",
            "previous_control",
            "reason",
            "applied_at"
          ],
          "additionalProperties": false
        },
        "suppression": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "expired"
              ]
            },
            "reason": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "expires_at": {
              "type": "string"
            },
            "matched_on": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "applied_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "status",
            "reason",
            "owner",
            "expires_at",
            "applied_at"
          ],
          "additionalProperties": false
        },
        "baseline_status": {
          "type": "string",
          "enum": [
            "new",
            "existing"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AgentCSP Finding/properties/matched_object/properties/evidence/items"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "rule_id",
        "name",
        "category",
        "severity",
        "confidence",
        "matched_object",
        "file_path",
        "reason",
        "trust_boundary_crossed",
        "data_classes",
        "recommended_control",
        "risk"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
