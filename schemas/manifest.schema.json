                "required": [
                  "id",
                  "type",
                  "name",
                  "path",
                  "trust_level"
                ],
                "additionalProperties": false
              },
              "target": {
                "$ref": "#/definitions/AgentCSP Agent Manifest/properties/relationships/items/properties/source"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "influences",
                  "loads",
                  "calls",
                  "reads",
                  "writes",
                  "uses_secret",
                  "external_reach",
                  "persists",
                  "triggers"
                ]
              },
              "reason": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/AgentCSP Agent Manifest/properties/agents/items/properties/evidence/items"
                },
                "default": []
              }
            },
            "required": [
              "id",
              "source",
              "target",
              "relation",
              "reason"
            ],
            "additionalProperties": false
          },
          "default": []
