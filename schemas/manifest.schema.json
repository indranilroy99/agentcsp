            "required": [
              "id",
              "title",
              "severity",
              "confidence",
              "source",
              "target",
              "reason",
              "recommended_control",
              "risk"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "severity": {
                "$ref": "#/definitions/AgentCSP Agent Manifest/properties/attack_paths/items/properties/severity"
              },
              "confidence": {
                "$ref": "#/definitions/AgentCSP Agent Manifest/properties/attack_paths/items/properties/confidence"
              },
              "confidence_rationale": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "matched_object": {
                "$ref": "#/definitions/AgentCSP Agent Manifest/properties/agents/items"
              },
              "file_path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "trust_boundary_crossed": {
                "type": "boolean"
              },
              "data_classes": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/AgentCSP Agent Manifest/properties/agents/items/properties/data_classes/items"
                }
              },
              "recommended_control": {
                "$ref": "#/definitions/AgentCSP Agent Manifest/properties/attack_paths/items/properties/recommended_control"
              },
              "risk": {
                "$ref": "#/definitions/AgentCSP Agent Manifest/properties/attack_paths/items/properties/risk"
              },
              "maps_to": {
                "type": "object",
                "properties": {
                  "owasp": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "mitre_atlas": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "nist_ai_rmf": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  }
                },
                "additionalProperties": false,
                "default": {
                  "owasp": [],
                  "mitre_atlas": [],
                  "nist_ai_rmf": []
                }
              },
              "suppression": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "expired"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "string"
                  },
                  "matched_on": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "applied_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "status",
                  "reason",
                  "owner",
                  "expires_at",
                  "applied_at"
                ],
                "additionalProperties": false
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/AgentCSP Agent Manifest/properties/agents/items/properties/evidence/items"
                },
                "default": []
              }
            },
            "required": [
              "id",
              "rule_id",
              "name",
              "category",
              "severity",
              "confidence",
              "matched_object",
              "file_path",
              "reason",
              "trust_boundary_crossed",
              "data_classes",
              "recommended_control",
              "risk"
            ],
            "additionalProperties": false
          },
          "default": []
