                  "actions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/AgentCSP Agent Manifest/properties/agents/items/properties/actions/items"
                    },
                    "default": []
                  },
                  "side_effect": {
                    "type": "boolean",
                    "default": false
                  },
                  "reversible": {
                    "type": "boolean",
                    "default": true
                  },
                  "external_reach": {
                    "type": "boolean",
                    "default": false
                  },
                  "secret_exposure": {
                    "type": "boolean",
                    "default": false
                  },
                  "untrusted_to_privileged": {
                    "type": "boolean",
                    "default": false
                  },
                  "score": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "rationale": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  }
                },
                "required": [
                  "trust_level"
                ],
                "additionalProperties": false
