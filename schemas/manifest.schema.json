        "attack_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "very_high"
                ]
              },
              "source": {
                "$ref": "#/definitions/AgentCSP Agent Manifest/properties/relationships/items/properties/source"
              },
              "target": {
                "$ref": "#/definitions/AgentCSP Agent Manifest/properties/relationships/items/properties/source"
              },
              "edges": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/AgentCSP Agent Manifest/properties/relationships/items"
                },
                "default": []
              },
              "reason": {
                "type": "string"
              },
              "recommended_control": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny",
                  "require_approval",
                  "redact",
                  "quarantine",
                  "warn"
                ]
              },
              "risk": {
                "type": "object",
                "properties": {
                  "trust_level": {
                    "$ref": "#/definitions/AgentCSP Agent Manifest/properties/agents/items/properties/trust_level"
