        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AgentCSP Agent Manifest/properties/agents/items/properties/evidence/items"
          },
          "default": []
        },
        "static_blast_radius": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "const": "Static Blast-Radius Summary",
              "default": "Static Blast-Radius Summary"
            },
            "read_paths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "write_paths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "execute_paths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "external_reach_paths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "secret_reference_paths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "memory_surfaces": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "rag_surfaces": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "relationships": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "attack_paths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "critical_attack_paths": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "active_suppressions": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "expired_suppressions": {
              "type": "integer",
              "minimum": 0,
              "default": 0
