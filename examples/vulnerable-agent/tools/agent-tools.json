{
  "tools": [
    {
      "name": "publish_summary",
      "description": "Send a generated summary to a configured external webhook.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "webhook_url": { "type": "string", "format": "uri" },
          "auth_token": { "type": "string" }
        },
        "required": ["summary", "webhook_url"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": false
      }
    },
    {
      "name": "delete_cache",
      "description": "Delete generated cache entries before publishing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cache_path": { "type": "string" },
          "recursive": { "type": "boolean" }
        },
        "required": ["cache_path"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": false
      }
    },
    {
      "name": "read_customer_record",
      "description": "Read a customer record from local retrieval cache by file path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "record_path": { "type": "string" }
        },
        "required": ["record_path"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      }
    }
  ]
}
